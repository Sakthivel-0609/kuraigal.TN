msgstr "பிரச்சனை காலவரிசை"

msgid "Comments"
msgstr "கருத்துகள்"

msgid "No comments yet."
msgstr "இன்னும் கருத்துகள் இல்லை."

msgid "Post Comment"
msgstr "கருத்தை இடு"

msgid "to comment."
msgstr "கருத்து தெரிவிக்க."

msgid "Nearby Issues"
msgstr "அருகிலுள்ள பிரச்சனைகள்"

msgid "away"
msgstr "தூரத்தில்"

