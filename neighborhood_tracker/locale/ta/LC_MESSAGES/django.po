msgid "Resolved"
msgstr "தீர்க்கப்பட்டது"

msgid "Active Emergencies"
msgstr "நடப்பு அவசரங்கள்"

msgid "Resolution Rate"
msgstr "தீர்வு விகிதம்"

msgid "Category-wise"
msgstr "வகை வாரியாக"

msgid "Status-wise"
msgstr "நிலை வாரியாக"

