msgstr "எண்ணிக்கை"

msgid "No area data yet."
msgstr "இன்னும் பகுதி தரவு இல்லை."

msgid "No notifications yet."
msgstr "இன்னும் அறிவிப்புகள் இல்லை."

msgid "Community Leaderboard"
msgstr "சமூக தலைமை பட்டியல்"

msgid "Top contributors ranked by community points."
msgstr "சமூக புள்ளிகளின் அடிப்படையில் முதன்மை பங்களிப்பாளர்கள்."

msgid "User"
msgstr "பயனர்"

msgid "Badge"
msgstr "பட்டயம்"

msgid "Points"
msgstr "புள்ளிகள்"

msgid "No contributors yet."
msgstr "இன்னும் பங்களிப்பாளர்கள் இல்லை."

msgid "My Profile"
msgstr "எனது சுயவிவரம்"

msgid "points"
msgstr "புள்ளிகள்"

msgid "Next badge"
msgstr "அடுத்த பட்டயம்"

